{
  "name": "@kromia/react",
  "version": "1.6.0",
  "private": true,
  "description": "Renderers React del SDK Kromia. Contiene los 8 recipe components + utilities (AvatarBox, ScalarText, ComposableSlot, InitialsAvatar) que Studio y el futuro consumer Flutter (via @kromia/flutter, paquete espejo) consumen como Legos para componer pantallas. Lógica del modelo viene de @kromia/core; este package solo aporta el JSX/CSS.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "tsc --noEmit"
  },
  "peerDependencies": {
    "@kromia/core": "workspace:*",
    "lucide-react": ">=0.460.0",
    "react": ">=19.0.0",
    "react-dom": ">=19.0.0"
  },
  "devDependencies": {
    "@kromia/core": "workspace:*",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "lucide-react": "^0.460.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0"
  }
}
