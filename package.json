{
  "name": "kromia-sdk",
  "version": "1.0.0",
  "private": true,
  "description": "Monorepo del SDK Kromia: contracts/ (JSON + schemas) + playbooks/ (procesos) + packages/core (TS core) + packages/react (futuro, KRO-82) + packages/flutter (futuro, KRO-83).",
  "type": "module",
  "scripts": {
    "gen": "pnpm --filter @kromia/core gen",
    "test": "pnpm --filter @kromia/core test",
    "build": "pnpm -r build",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0"
  },
  "packageManager": "pnpm@11.1.3"
}
